QMenu {
    background-color: {{colors.surface_container.default.hex}};
    color: {{colors.on_surface.default.hex}};
    border: 1px solid {{colors.outline_variant.default.hex}};
    border-radius: 12px;
    padding: 6px;
}
QMenu::item {
    background-color: transparent;
    color: {{colors.on_surface.default.hex}};
    border-radius: 8px;
    padding: 6px 20px 6px 10px;
    margin: 2px 0px;
}
QMenu::item:selected {
    background-color: {{colors.primary_container.default.hex}};
    color: {{colors.on_primary_container.default.hex}};
}
QMenu::item:disabled {
    color: {{colors.outline.default.hex}};
}
QMenu::separator {
    height: 1px;
    background-color: {{colors.outline_variant.default.hex}};
    margin: 4px 6px;
}
